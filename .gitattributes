# Fins de ligne LF imposées partout (Windows / Linux / WSL / Overleaf cohérents).
* text=auto eol=lf

# Sources texte, explicitement en LF
*.tex       text eol=lf
*.cls       text eol=lf
*.sty       text eol=lf
*.bib       text eol=lf
*.md        text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
.latexmkrc  text eol=lf

# Binaires : ne jamais convertir
*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
